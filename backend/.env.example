PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
# Optional: custom SQLite file location
# DB_PATH=./database/freelancehub.sqlite

# Google Sign-In: OAuth Web Client ID from Google Cloud Console (public value, no client secret needed)
GOOGLE_CLIENT_ID=your_google_client_id
